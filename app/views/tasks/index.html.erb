<h1><%= t('tasks.index.title') %></h1>

<%= form_with url: tasks_path, method: :get, scope: :search, local: true do |f| %>
  <div>
    <%= f.label :status, t('tasks.index.table.status') %>
    <%= f.select :status, Task.statuses.keys.map { |s| [t("enums.status.#{s}"), s] }, { include_blank: true }, {} %>
  </div>
  <div>
    <%= f.label :title, t('tasks.index.table.title') %>
    <%= f.text_field :title %>
  </div>
  <div>
    <%= f.label :label_id, 'Label' %>
    <%= f.select :label_id, current_user.labels.map { |l| [l.name, l.id] }, { include_blank: true }, {} %>
  </div>
  <%= f.submit t('tasks.index.search'), id: 'search_task' %>
<% end %>

<table>
  <thead>
    <tr>
      <th><%= t('tasks.index.table.title') %></th>
      <th><%= t('tasks.index.table.content') %></th>
      <th><%= link_to t('tasks.index.table.deadline_on'), sort_deadline_on: true %></th>
      <th><%= link_to t('tasks.index.table.priority'), sort_priority: true %></th>
      <th><%= t('tasks.index.table.status') %></th>
      <th><%= t('tasks.index.table.created_at') %></th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.deadline_on %></td>
        <td><%= t("enums.priority.#{task.priority}") %></td>
        <td><%= t("enums.status.#{task.status}") %></td>
        <td><%= task.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
        <td><%= link_to t('tasks.index.table.show'), task_path(task), class: 'show-task' %></td>
        <td><%= link_to t('tasks.index.table.edit'), edit_task_path(task), class: 'edit-task' %></td>
        <td><%= link_to t('tasks.index.table.destroy'), task_path(task), class: 'destroy-task', method: :delete, data: { confirm: t('tasks.index.confirm') } %></td>
      </tr>
    <% end %>
  </tbody>
</table>

<%= paginate @tasks %>