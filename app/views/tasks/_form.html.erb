<%= form_with(model: task, local: true) do |form| %>
  <% if task.errors.any? %>
    <div>
      <ul>
        <% task.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, Task.human_attribute_name(:title) %>
    <%= form.text_field :title %>
  </div>

  <div>
    <%= form.label :content, Task.human_attribute_name(:content) %>
    <%= form.text_area :content %>
  </div>

  <div>
    <%= form.label :deadline_on, Task.human_attribute_name(:deadline_on) %>
    <%= form.date_field :deadline_on %>
  </div>

  <div>
    <%= form.label :priority, Task.human_attribute_name(:priority) %>
    <%= form.select :priority, Task.priorities.keys.map { |p| [t("enums.priority.#{p}"), p] }, { include_blank: true } %>
  </div>

  <div>
    <%= form.label :status, Task.human_attribute_name(:status) %>
    <%= form.select :status, Task.statuses.keys.map { |s| [t("enums.status.#{s}"), s] }, { include_blank: true } %>
  </div>

  <div>
    <%= form.label :label_ids, 'Label' %>
    <% current_user.labels.each do |label| %>
      <%= form.check_box :label_ids, { multiple: true, include_hidden: false }, label.id, nil %>
      <%= label.name %>
    <% end %>
  </div>
  
  <div>
    <% if task.new_record? %>
      <%= form.submit t('tasks.new.submit'), id: 'create-task' %>
    <% else %>
      <%= form.submit t('tasks.edit.submit'), id: 'update-task' %>
    <% end %>
  </div>
<% end %>