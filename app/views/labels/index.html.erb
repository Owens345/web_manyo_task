<h1>Label list page</h1>
<table class="table">
  <thead>
    <tr>
      <th>Name</th>
      <th>Number of tasks</th>
      <th colspan="2"></th>
    </tr>
  </thead>
  <tbody>
    <% @labels.each do |label| %>
      <tr>
        <td><%= label.name %></td>
        <td><%= label.tasks.count %></td>
        <td><%= link_to 'edit', edit_label_path(label), class: 'edit-label btn btn-sm btn-warning' %></td>
        <td><%= link_to 'delete', label_path(label), class: 'destroy-label btn btn-sm btn-danger', method: :delete, data: { confirm: 'Are you sure you want to delete this?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
