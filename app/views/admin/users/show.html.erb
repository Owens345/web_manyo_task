<h1>User details page</h1>
<p><strong>Name</strong> <%= @user.name %></p>
<p><strong>Email address</strong> <%= @user.email %></p>
<p><strong>Administrator rights</strong> <%= @user.admin? ? 'Yes' : 'No' %></p>
<table class="table">
  <thead>
    <tr>
      <th>Title</th><th>Content</th><th>Creation date and time</th>
      <th>End date</th><th>Priority</th><th>Status</th>
    </tr>
  </thead>
  <tbody>
    <% @user.tasks.each do |task| %>
      <tr>
        <td><%= task.title %></td>
        <td><%= task.content %></td>
        <td><%= task.created_at.strftime('%Y-%m-%d %H:%M:%S') %></td>
        <td><%= task.deadline_on %></td>
        <td><%= t("enums.priority.#{task.priority}") %></td>
        <td><%= t("enums.status.#{task.status}") %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%= link_to 'Return', admin_users_path, id: 'back', class: 'btn btn-secondary' %>
