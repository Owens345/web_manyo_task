<h1>User list page</h1>
<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Email address</th>
      <th>Admin rights</th>
      <th>Number of tasks</th>
      <th colspan="3"></th>
    </tr>
  </thead>
  <tbody>
    <% @users.each do |user| %>
      <tr>
        <td><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.admin? ? 'Yes' : 'No' %></td>
        <td><%= user.tasks.size %></td>
        <td><%= link_to 'Details', admin_user_path(user), class: 'show-user' %></td>
        <td><%= link_to 'edit', edit_admin_user_path(user), class: 'edit-user' %></td>
        <td><%= link_to 'delete', admin_user_path(user), class: 'destroy-user', method: :delete, data: { confirm: 'Are you sure you want to delete this user?' } %></td>
      </tr>
    <% end %>
  </tbody>
</table>
